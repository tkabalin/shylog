# Copy to instances/<name>.env for a deployment (one file per instance), or
# to .env for development. See the README.

# Compose project, one per instance, such as shylog or shylog-<name>
COMPOSE_PROJECT_NAME=
# Tailscale logins allowed to use this instance, comma-separated
SHYLOG_ALLOWED_LOGINS=diver@example.com
# The app's origin as the browser sees it (Tailscale Serve, HTTPS)
SHYLOG_ORIGIN=https://shylog.example.ts.net
# Holds shylog.db, export/, snapshots/, cards/ and tailscale/
SHYLOG_DATA_DIR=/srv/shylog/diver
# Page title and installed app name
SHYLOG_APP_NAME=Shylog
# Tailnet hostname
TS_HOSTNAME=shylog
# Joins the tailnet on first start; clear it once the node has joined
TS_AUTHKEY=
# Deployment only: the nightly snapshot runs at midnight in this zone, so
# set it to the server's, and keep midnight clear of the host's own backup
# job. In a development .env it would move the dev server's clock.
# TZ=Africa/Johannesburg
# Image tag to run: latest follows main, sha-<commit> pins one build
SHYLOG_TAG=latest
# A fork's own image, without the tag
# SHYLOG_IMAGE=ghcr.io/tkabalin/shylog
# The app's memory limit; a large UDDF import is the peak
# SHYLOG_MEMORY_LIMIT=1g

# Development only. In a deployment Compose sets 3000, where
# tailscale/serve.json forwards.
PORT=3000
# Stands in for the Tailscale-User-Login header. The server refuses to
# start with this set when NODE_ENV=production.
# SHYLOG_DEV_LOGIN=diver@example.com
